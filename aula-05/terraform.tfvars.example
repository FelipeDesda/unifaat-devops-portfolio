# ============================================================
# Copie este arquivo para terraform.tfvars e preencha os valores
# ATENÇÃO: terraform.tfvars está no .gitignore — nunca commite!
# ============================================================

# Região AWS
aws_region   = "us-east-1"
project_name = "technova"

# Rede
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidr    = "10.0.1.0/24"
private_subnet_1_cidr = "10.0.10.0/24"
private_subnet_2_cidr = "10.0.11.0/24"
availability_zone_1   = "us-east-1a"
availability_zone_2   = "us-east-1b"

# EC2
ec2_instance_type = "t2.micro"
ec2_ami           = "ami-0c02fb55956c7d316"  # Amazon Linux 2023 - us-east-1
key_pair_name     = "minha-chave-aws"        # Nome do Key Pair já criado na AWS

# RDS (SENSÍVEL - não commite valores reais!)
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_engine_version    = "15"
db_name              = "technova_db"
db_username          = "technova_admin"      # Troque por um usuário seguro
db_password          = "SenhaForte2026!"     # Troque por uma senha forte (sem / @ " ou espaços — restrição do RDS)

# Remote State
tfstate_bucket_name = "technova-tfstate-unifaat"
